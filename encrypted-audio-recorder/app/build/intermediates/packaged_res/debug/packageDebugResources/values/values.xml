<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_amber">#F59E0B</color>
    <color name="accent_cyan">#0EA5E9</color>
    <color name="accent_emerald">#10B981</color>
    <color name="accent_red">#EF4444</color>
    <color name="bg_dark">#0F172A</color>
    <color name="card_bg">#1E293B</color>
    <color name="card_border">#334155</color>
    <color name="status_active_bg">#064E3B</color>
    <color name="status_active_text">#34D399</color>
    <color name="status_idle_bg">#1E293B</color>
    <color name="status_idle_text">#94A3B8</color>
    <color name="status_rec_bg">#7F1D1D</color>
    <color name="status_rec_text">#FCA5A5</color>
    <color name="surface_variant">#1A2332</color>
    <color name="text_muted">#64748B</color>
    <color name="text_primary">#F8FAFC</color>
    <color name="text_secondary">#94A3B8</color>
    <string name="app_name">Encrypted Audio Recorder</string>
    <style name="CustomAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/card_bg</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="editTextColor">@color/text_primary</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="colorPrimary">@color/accent_cyan</item>
    </style>
    <style name="Theme.EncryptedRecorder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorSecondary">@color/accent_emerald</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="alertDialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/CustomAlertDialogTheme</item>
    </style>
</resources>