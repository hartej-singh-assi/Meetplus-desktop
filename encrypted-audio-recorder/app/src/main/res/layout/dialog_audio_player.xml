<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:padding="20dp">

    <!-- Header / Track Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvPlayerFileName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="rec_20260811_120000.m4a.enc"
            android:fontFamily="monospace"
            android:textColor="@color/accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DECRYPTED"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="#064E3B" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPlayerFileInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AES-256 GCM In-Memory Decryption • 128 KB"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="20dp" />

    <!-- Seek Bar -->
    <SeekBar
        android:id="@+id/seekBarAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="@color/accent_cyan"
        android:thumbTint="@color/accent_cyan"
        android:progressBackgroundTint="@color/card_border"
        android:layout_marginBottom="4dp" />

    <!-- Timestamps Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main Player Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRewind"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:text="-10s"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            app:backgroundTint="#334155"
            android:padding="0dp"
            android:layout_marginEnd="16dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Play/Pause"
            app:srcCompat="@android:drawable/ic_media_play"
            app:backgroundTint="@color/accent_cyan"
            app:tint="#FFFFFF"
            app:fabSize="normal"
            android:layout_marginEnd="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnForward"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:text="+10s"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            app:backgroundTint="#334155"
            android:padding="0dp" />

    </LinearLayout>

    <!-- Speed / Stop Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speed:"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeed"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="1.0x"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:strokeColor="@color/card_border"
            app:cornerRadius="8dp"
            android:paddingHorizontal="10dp" />

        <android.widget.Space
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopAudio"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Stop"
            android:textColor="@color/accent_red"
            android:textSize="12sp"
            app:strokeColor="@color/accent_red"
            app:cornerRadius="8dp"
            android:paddingHorizontal="14dp" />

    </LinearLayout>

</LinearLayout>
